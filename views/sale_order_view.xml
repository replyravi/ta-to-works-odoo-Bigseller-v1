<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ── Sale Order Form: Marketplace header fields ──────────────── -->
        <record id="bigseller_v1_sale_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.bigseller.v1.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <!-- Add Marketplace group after commitment_date -->
                <xpath expr="//field[@name='commitment_date']" position="after">
                    <field name="buyer_designed_logistics"/>
                </xpath>

                <xpath expr="//group[@name='sale_header']" position="after">
                    <group string="Marketplace" name="marketplace_group"
                           attrs="{'invisible': [('mp_marketplace', '=', False)]}">
                        <group>
                            <field name="mp_marketplace" readonly="1"/>
                            <field name="mp_status" readonly="1"/>
                            <field name="bigseller_shop_name" readonly="1"
                                   attrs="{'invisible': [('bigseller_shop_name', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="mp_last_update" readonly="1"/>
                            <field name="bigseller_order_id" readonly="1"
                                   attrs="{'invisible': [('bigseller_order_id', '=', False)]}"/>
                            <field name="bigseller_platform_order_id" readonly="1"
                                   attrs="{'invisible': [('bigseller_platform_order_id', '=', False)]}"/>
                        </group>
                    </group>
                </xpath>

                <!-- Add MP Status History tab -->
                <xpath expr="//notebook" position="inside">
                    <page string="MP Status" name="mp_status_tab"
                          attrs="{'invisible': [('mp_marketplace', '=', False)]}">
                        <field name="mp_status_history_ids" nolabel="1">
                            <tree create="0" delete="0" editable="0">
                                <field name="update_date"/>
                                <field name="marketplace"/>
                                <field name="bigseller_status"/>
                                <field name="mp_status"/>
                                <field name="odoo_action"/>
                                <field name="notes"/>
                            </tree>
                        </field>
                    </page>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
